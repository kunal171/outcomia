SOLANA_RPC_URL=https://api.devnet.solana.com
OUTCOMIA_PROGRAM_ID=AG4ztZvcZjzFKjoXLzH8M6U3if9CwVFTXH2FHjqg7SdL
DATABASE_URL=postgres://outcomia:outcomia_dev@127.0.0.1:5434/outcomia_indexer
SOLANA_WS_URL=wss://api.devnet.solana.com
HEALTH_ADDRESS=0.0.0.0:8080

# GraphQL/auth API; APP_ORIGIN must exactly match the browser origin.
API_ADDRESS=127.0.0.1:8081
APP_ORIGIN=http://localhost:3000
# Optional; must equal the app's INDEXER_PROXY_SECRET (32+ characters). Lets the
# app proxy forward browser IPs for per-client sign-in limits.
INDEXER_PROXY_SECRET=

# Optional Canton sign-in and profile linking. Set all five or none. The token
# is a read-only operator credential; the indexer only reads ProfileClaim
# contracts and never submits. HTTPS only (HTTP allowed on loopback).
CANTON_JSON_API_URL=
CANTON_READ_TOKEN=
CANTON_OPERATOR_PARTY=
# Package id of the deployed outcomia-markets DAR (contains Outcomia.Profiles).
CANTON_PROFILES_PACKAGE_ID=
# Must equal the app's NEXT_PUBLIC_CANTON_NETWORK_ID, e.g. canton:testnet.
CANTON_NETWORK=
