# Private primary RPC. These values stay on the server; never prefix the key with NEXT_PUBLIC_.
HELIUS_RPC_URL=https://devnet.helius-rpc.com
HELIUS_API_KEY=your-server-key
NEXT_PUBLIC_RPC_PROXY_ENABLED=true
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com/
# Key-free browser fallback if the proxy/provider is unavailable.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Comma-separated devnet HTTP endpoints. Read failover only; broadcasts are not replayed.
NEXT_PUBLIC_SOLANA_RPC_FALLBACK_URLS=https://solana-devnet.api.onfinality.io/public,https://api.devnet.solana.com
NEXT_PUBLIC_OUTCOMIA_PROGRAM_ID=AG4ztZvcZjzFKjoXLzH8M6U3if9CwVFTXH2FHjqg7SdL

# Enable only after deploying both prediction market and position initializers.
NEXT_PUBLIC_PREDICTION_DRAFTS_ENABLED=true

# Enable only after deploying open_prediction_market alongside the initializers.
NEXT_PUBLIC_PREDICTION_OPENING_ENABLED=true

# Enable only after deploying prediction deposits, withdrawals and complete sets.
# The current devnet program supports funding; disable for older binaries.
NEXT_PUBLIC_PREDICTION_FUNDING_ENABLED=true

# Exit path is independent of new-order rollout. Enable only after deploying
# cancel_prediction_order; disabling new orders must not disable cancellation.
NEXT_PUBLIC_PREDICTION_CANCELLATION_ENABLED=true

# Bounded matching with global taker fees. Enable only after deploying
# match_prediction_order; also requires draft, funding and cancellation flags.
NEXT_PUBLIC_PREDICTION_MATCHING_ENABLED=true

# Resting placement and automatic safe limit remainders; requires cancellation.
# Disable when targeting a program without these instructions.
NEXT_PUBLIC_PREDICTION_ORDERS_ENABLED=true

# Server-only devnet faucet. Never prefix the secret with NEXT_PUBLIC_ and
# configure these values in Vercel's encrypted environment settings.
FAUCET_AUTHORITY_SECRET_KEY=[64-byte JSON array]
FAUCET_BASE_MINT=FggaZG7eJ5tpr2vmpNMbMCHkWkcw9n2Nhmf54g3wQwGk
FAUCET_QUOTE_MINT=8KRa3QwidV2yZspR3wr4p3eNzq2KtejMbU1tZUgNLdtt
FAUCET_BASE_CLAIM_ATOMS=1000000000
FAUCET_QUOTE_CLAIM_ATOMS=1000000000
FAUCET_SOLANA_RPC_URL=https://api.devnet.solana.com
FAUCET_WALLET_LIMIT=1
FAUCET_IP_LIMIT=5
FAUCET_WINDOW_SECONDS=3600

# Local development only. Vercel ignores this fallback and requires Upstash.
FAUCET_ALLOW_IN_MEMORY_RATE_LIMIT=false

# Required on Vercel. Local development uses a process-local fallback only.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# New custody/resolution rollout. Enable only after upgrading and verifying the program.
NEXT_PUBLIC_SHARED_BALANCES_ENABLED=false
NEXT_PUBLIC_PREDICTION_RESOLUTION_ENABLED=false

# Loop / Console Wallet network for Canton prediction markets (public configuration).
NEXT_PUBLIC_CANTON_NETWORK_ID=canton:testnet

# Canton server-only discovery. Leave empty until the DAR and roots are deployed.
# Use a read-only token restricted to CANTON_OPERATOR_PARTY. Never expose it to the browser.
CANTON_PACKAGE_ID=
CANTON_OPERATOR_PARTY=
CANTON_VAULT_PARTY=
CANTON_PROTOCOL_NAME=outcomia
CANTON_SYNCHRONIZER_ID=
CANTON_JSON_API_URL=
CANTON_CATALOG_TOKEN=
# Registry-specific, read-only context provider; see docs/canton-trading.md.
CANTON_REGISTRY_CONTEXT_URL=
CANTON_REGISTRY_CONTEXT_TOKEN=
# Enable only after deployment and real wallet/registry verification.
CANTON_TRADING_ENABLED=false
