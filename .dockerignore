# Indexer build context: explicit inputs only; never upload local env/wallet files.
# List files, not directories: re-including a directory (for example "!app/")
# also re-includes everything beneath it, such as node_modules, build output
# and local .env files.
**
!services/indexer/Cargo.toml
!services/indexer/Cargo.lock
!services/indexer/src/**
!services/indexer/migrations/**
!app/idl/outcomia.json
