<diagram id="shared-wallet-settlement" name="Shared wallet and settlement"><mxGraphModel grid="1" page="1" pageWidth="1200" pageHeight="1450"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s-title" value="Shared balances and prediction settlement - deployed on devnet" style="text;html=1;align=center;fontSize=22;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1040" height="50" as="geometry"/></mxCell><mxCell id="s-ui" value="Next.js wallet + market pages&lt;br&gt;Explicit rollout flags; owner-signed actions" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="480" height="70" as="geometry"/></mxCell><mxCell id="s-ledger" value="AssetBalance PDA&lt;br&gt;[asset_balance, owner, mint]&lt;br&gt;free + locked across markets" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="90" y="270" width="310" height="100" as="geometry"/></mxCell><mxCell id="s-vault" value="One SPL vault per mint&lt;br&gt;backs global cash + shared-book fees&lt;br&gt;deposit / withdraw by owner" style="shape=cylinder3;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="90" y="460" width="310" height="100" as="geometry"/></mxCell><mxCell id="s-book" value="SharedBook / SharedOrder / SharedPriceLevel&lt;br&gt;Spot + YES / NO lists&lt;br&gt;price priority, FIFO, per-order locks, fees" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="500" y="270" width="530" height="100" as="geometry"/></mxCell><mxCell id="s-outcome" value="PredictionPosition (question + owner)&lt;br&gt;YES / NO free and locked contracts&lt;br&gt;Cash uses AssetBalance" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="580" y="460" width="400" height="100" as="geometry"/></mxCell><mxCell id="s-reserve" value="Question collateral vault&lt;br&gt;backing reserve stays isolated&lt;br&gt;split in; merge / redeem out" style="shape=cylinder3;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="560" height="85" as="geometry"/></mxCell><mxCell id="s-resolver" value="Stored active-admin resolver&lt;br&gt;propose / correct with evidence&lt;br&gt;published earliest time + fallback window" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="80" y="850" width="440" height="100" as="geometry"/></mxCell><mxCell id="s-final" value="Permissionless finalization&lt;br&gt;mature proposal or committed Invalid timeout&lt;br&gt;Caller cannot choose a different outcome" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="650" y="850" width="450" height="100" as="geometry"/></mxCell><mxCell id="s-claim" value="Owner redemption burns free contracts&lt;br&gt;YES winner: full payout; NO winner: full payout&lt;br&gt;Invalid: half each; locked claims must be canceled" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="310" y="1060" width="570" height="100" as="geometry"/></mxCell><mxCell id="s-legacy" value="Legacy queues and cash remain separate&lt;br&gt;Cancel old orders; transfer only free cash with owner signature&lt;br&gt;No account reinterpretation, automatic migration or mixing liquidity" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="210" y="1250" width="770" height="95" as="geometry"/></mxCell><mxCell id="s-e0" value="fund / recover" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-ui" target="s-ledger"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e1" value="place / fill / cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-ui" target="s-book"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e2" value="equal claim / token movement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-ledger" target="s-vault"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e3" value="global cash locks / settlement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-ledger" target="s-book"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e4" value="per-question contract locks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-book" target="s-outcome"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e5" value="split / merge backing CPI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-ledger" target="s-reserve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e6" value="fully backed claims" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-outcome" target="s-reserve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e7" value="proposal + review delay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-resolver" target="s-final"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e8" value="fixed final payout schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-final" target="s-claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e9" value="payout credited globally" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-claim" target="s-ledger"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e10" value="reserve reduced equally" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-claim" target="s-reserve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s-e11" value="free cash migration only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-legacy" target="s-ledger"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
