        </mxCell>
        <mxCell id="predictionResolution" value="Resolution lifecycle&lt;br&gt;Close -&gt; primary / optional fallback proposal&lt;br&gt;Evidence + delay -&gt; final payout&lt;br&gt;Invalid timeout requires a configured deadline&lt;br&gt;Cancel, redeem, withdraw after resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="predictionGroup">
          <mxGeometry x="560" y="270" width="350" height="110" as="geometry"/>
        </mxCell>
