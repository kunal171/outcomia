        <mxCell id="legend" value="Dashed boxes and edges are planned. Existing spot accounts are not reused as fake prediction assets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
