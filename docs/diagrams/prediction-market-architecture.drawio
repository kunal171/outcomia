        <mxCell id="yesBook" value="YES order book&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sorted bid / ask levels&lt;br&gt;FIFO orders at each price&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontStyle=1;" vertex="1" parent="1">
