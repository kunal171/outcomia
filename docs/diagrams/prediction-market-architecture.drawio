        <mxCell id="resolution" value="Resolution state (detail on page 2)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Close -&gt; primary or optional fallback proposal -&gt; delay -&gt; finalize&lt;br&gt;Invalid timeout only with a configured fallback deadline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;" vertex="1" parent="1">
