  <diagram id="resolution-and-switching" name="Rules, resolution and switching">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="detail-title" value="Prediction rules and execution (all planned)" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="arweave" value="Arweave rules document&lt;br&gt;Question, criteria, source priority, evidence requirements&lt;br&gt;Resolver keys, time windows, timeout policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="verify-client" value="Client verifies document hash&lt;br&gt;and compares structured terms&lt;br&gt;with market account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="490" y="100" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="chain-terms" value="Program enforces stored terms&lt;br&gt;Resolver keys + timestamps + transitions&lt;br&gt;Rules fixed before opening; evidence hash per proposal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="rules-client" value="fetch + hash exact bytes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="arweave" target="verify-client"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="client-chain" value="verify matching configuration" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="verify-client" target="chain-terms"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="close" value="now &gt;= close_ts&lt;br&gt;Placement and matching reject&lt;br&gt;Cancellation remains available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="primary" value="Creator + active admin proposes outcome&lt;br&gt;Earliest = optional time or close_ts&lt;br&gt;Ends at fallback activation time if configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="390" y="290" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="fallback" value="Predeclared fallback + active admin&lt;br&gt;Activate only if no primary proposal&lt;br&gt;available_ts &lt;= now; deadline optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="390" y="460" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="proposal" value="Proposal + evidence URI/hash&lt;br&gt;Wait full resolution delay&lt;br&gt;Correction restarts delay within resolver window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="290" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="final" value="Permissionless finalization&lt;br&gt;YES / NO / Invalid&lt;br&gt;Immutable payout; redeem then withdraw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="460" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="c-p" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="close" target="primary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-proposal" value="propose in window" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="primary" target="proposal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-fallback" value="no proposal at fallback time" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="primary" target="fallback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-proposal" value="respect deadline if configured" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="fallback" target="proposal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="proposal-final" value="delay elapsed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="proposal" target="final"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fallback-invalid" value="only if deadline exists and no proposal: Invalid" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="fallback" target="final"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="optional-policy-note" value="No fallback or no fallback deadline: no automatic timeout payout. Resolver silence may leave unpaired positions unresolved. These choices are fixed before opening." style="text;html=1;whiteSpace=wrap;align=left;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1100" height="45" as="geometry"/></mxCell>
        <mxCell id="switch-title" value="Later: atomic position switching within one market" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="sell" value="Sell free YES (or NO)&lt;br&gt;Bounded FIFO fills&lt;br&gt;Minimum quantity and net proceeds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="buy" value="Buy opposite outcome&lt;br&gt;Use net sale proceeds&lt;br&gt;Additional free collateral only if authorized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="720" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="guard" value="Final transaction guard&lt;br&gt;Minimum bought + maximum extra spend&lt;br&gt;Any failure rolls back both legs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="860" y="720" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="sell-buy" value="credit collateral after fees" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="sell" target="buy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="buy-guard" value="validate signed limits" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="buy" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="switch-note" value="Both legs require now &lt; close_ts and counterparties. No resting remainder. Loss is reflected in sale price, not a separate charge. Network fees may apply on failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1140" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
